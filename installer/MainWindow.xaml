<Window x:Class="PhantomInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom CFG Installer"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Opacity="0" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#090909"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#171717"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" CornerRadius="28" Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.58" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,18,18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#151515" ClipToBounds="True">
                    <Image Source="/IMG_0240.jpeg" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,1,0,0">
                    <TextBlock Text="PHANTOM" Foreground="White" FontWeight="Bold" FontSize="18" CharacterSpacing="180"/>
                    <TextBlock Text="CS2 CONFIG INSTALLER" Foreground="#777777" FontSize="10" Margin="1,4,0,0" CharacterSpacing="120"/>
                </StackPanel>
                <Button Grid.Column="2" Width="38" Height="38" Content="×" FontSize="23" Foreground="#A0A0A0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="54,28,54,24">
                <Grid x:Name="IntroPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ТВОЙ CS2.&#10;ОДНИМ КЛИКОМ." Foreground="White" FontSize="38" FontWeight="Bold" LineHeight="43"/>
                        <TextBlock Margin="0,20,28,0" Foreground="#999999" FontSize="14" TextWrapping="Wrap" LineHeight="22"
                                   Text="Установщик сам найдёт Counter-Strike 2, скопирует Phantom.cfg в правильную папку и подготовит команду запуска."/>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Border Background="#141414" CornerRadius="9" Padding="11,7" Margin="0,0,8,0"><TextBlock Text="120 FPS" Foreground="#D8D8D8" FontSize="11"/></Border>
                            <Border Background="#141414" CornerRadius="9" Padding="11,7" Margin="0,0,8,0"><TextBlock Text="TRACERS ON" Foreground="#D8D8D8" FontSize="11"/></Border>
                            <Border Background="#141414" CornerRadius="9" Padding="11,7"><TextBlock Text="ADMIN" Foreground="#D8D8D8" FontSize="11"/></Border>
                        </StackPanel>
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="УСТАНОВИТЬ PHANTOM CFG" Width="250" HorizontalAlignment="Left" Margin="0,30,0,0" Click="InstallButton_Click"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="230" Height="300" CornerRadius="24" Background="#111111" BorderBrush="#242424" BorderThickness="1" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image Source="/IMG_0240.jpeg" Stretch="UniformToFill" Opacity="0.86"/>
                            <Rectangle Fill="#55000000"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,22">
                                <TextBlock Text="PHANTOM" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="PERSONAL CONFIG" Foreground="#BEBEBE" FontSize="10" Margin="1,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="InstallPanel" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                        <TextBlock Text="УСТАНАВЛИВАЮ PHANTOM" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="InstallStatus" Text="Ищу директорию Counter-Strike 2…" Foreground="#8F8F8F" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,28"/>
                        <ProgressBar x:Name="InstallProgress" Height="4" IsIndeterminate="True" Background="#1D1D1D" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DonePanel" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
                        <Border Width="74" Height="74" CornerRadius="37" Background="White">
                            <TextBlock Text="✓" Foreground="#090909" FontSize="37" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ГОТОВО" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Phantom cfg установлен" Foreground="#999999" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock x:Name="InstalledPath" Foreground="#5F5F5F" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>

                        <Border Background="#111111" BorderBrush="#242424" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,22,0,0" Width="560">
                            <StackPanel>
                                <TextBlock Text="Остался один шаг в Steam" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="ПКМ по Counter-Strike 2 → Свойства → Основные → Параметры запуска" Foreground="#8A8A8A" FontSize="11" Margin="0,7,0,12"/>
                                <Grid>
                                    <Border Background="#080808" CornerRadius="9" Padding="13,10">
                                        <TextBlock Text="+exec Phantom.cfg" Foreground="#EAEAEA" FontFamily="Consolas" FontSize="13"/>
                                    </Border>
                                    <Button x:Name="CopyButton" Content="КОПИРОВАТЬ" HorizontalAlignment="Right" Width="122" Height="34" Margin="0,0,5,0" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10" Click="CopyButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="ГОТОВО" Style="{StaticResource PrimaryButton}" Width="180" Margin="0,20,0,0" Click="Finish_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ErrorPanel" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="540">
                        <TextBlock Text="НЕ НАШЁЛ CS2" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" Text="Не удалось найти папку Counter-Strike 2." Foreground="#999999" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,13,0,22"/>
                        <Button Content="ЗАКРЫТЬ" Style="{StaticResource PrimaryButton}" Width="170" Click="Finish_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="PHANTOM • LOCAL INSTALL • NO GAME MODIFICATION" Foreground="#3F3F3F" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Top" CharacterSpacing="80"/>
        </Grid>
    </Border>
</Window>
