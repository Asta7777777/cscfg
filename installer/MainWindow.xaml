<Window x:Class="PhantomInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom CFG Installer"
        Width="820" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Opacity="0" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#090909"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#181818"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30" Background="#090909" BorderBrush="#242424" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.60" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,17,18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="21" Background="#151515" ClipToBounds="True">
                    <Image Source="/assets/welcome.jpeg" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="13,2,0,0">
                    <TextBlock Text="PHANTOM" Foreground="White" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="CS2 CONFIG INSTALLER" Foreground="#707070" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Width="38" Height="38" Content="×" FontSize="23"
                        Foreground="#A0A0A0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="34,6,34,16" ClipToBounds="True">

                <!-- WELCOME -->
                <Grid x:Name="IntroPanel" ClipToBounds="True">
                    <Image x:Name="WelcomeArtwork"
                           Source="/assets/welcome.jpeg"
                           Width="490" Height="445"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Stretch="UniformToFill" Opacity="0.78"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                        </Image.RenderTransform>
                        <Image.OpacityMask>
                            <RadialGradientBrush Center="0.64,0.50" GradientOrigin="0.64,0.50" RadiusX="0.68" RadiusY="0.76">
                                <GradientStop Color="#FFFFFFFF" Offset="0.33"/>
                                <GradientStop Color="#E8FFFFFF" Offset="0.57"/>
                                <GradientStop Color="#6AFFFFFF" Offset="0.78"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Image.OpacityMask>
                    </Image>

                    <Rectangle HorizontalAlignment="Right" Width="540">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FA090909" Offset="0"/>
                                <GradientStop Color="#B7090909" Offset="0.34"/>
                                <GradientStop Color="#3A090909" Offset="0.70"/>
                                <GradientStop Color="#05090909" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel Width="405" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0">
                        <TextBlock Text="ВАС ПРИВЕТСТВУЕТ МАСТЕР УСТАНОВКИ"
                                   Foreground="#777777" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="PHANTOM CFG" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Персональный конфиг Counter-Strike 2"
                                   Foreground="#A0A0A0" FontSize="15" Margin="0,7,0,0"/>
                        <TextBlock Text="Установщик сам найдёт CS2, сохранит предыдущий Phantom.cfg и установит новую версию в правильную папку."
                                   Foreground="#7E7E7E" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,18,8,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,23,0,0">
                            <Border Background="#151515" CornerRadius="9" Padding="11,7" Margin="0,0,8,0">
                                <TextBlock Text="120 FPS" Foreground="#D8D8D8" FontSize="11"/>
                            </Border>
                            <Border Background="#151515" CornerRadius="9" Padding="11,7" Margin="0,0,8,0">
                                <TextBlock Text="TRACERS ON" Foreground="#D8D8D8" FontSize="11"/>
                            </Border>
                            <Border Background="#151515" CornerRadius="9" Padding="11,7">
                                <TextBlock Text="ADMIN" Foreground="#D8D8D8" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}"
                                Content="УСТАНОВИТЬ PHANTOM CFG" Width="258" HorizontalAlignment="Left"
                                Margin="0,29,0,0" Click="InstallButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- INSTALLING -->
                <Grid x:Name="InstallPanel" Visibility="Collapsed" Opacity="0" ClipToBounds="True">
                    <Image x:Name="InstallArtwork"
                           Source="/assets/installing.png"
                           Width="690" Height="455"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Stretch="UniformToFill" Opacity="0.60"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="InstallArtworkScale" ScaleX="1.04" ScaleY="1.04"/>
                        </Image.RenderTransform>
                        <Image.OpacityMask>
                            <RadialGradientBrush Center="0.63,0.50" GradientOrigin="0.63,0.50" RadiusX="0.72" RadiusY="0.82">
                                <GradientStop Color="#FFFFFFFF" Offset="0.34"/>
                                <GradientStop Color="#D6FFFFFF" Offset="0.58"/>
                                <GradientStop Color="#5AFFFFFF" Offset="0.80"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Image.OpacityMask>
                    </Image>

                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FC090909" Offset="0"/>
                                <GradientStop Color="#DA090909" Offset="0.38"/>
                                <GradientStop Color="#5A090909" Offset="0.72"/>
                                <GradientStop Color="#12090909" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Width="430" Margin="46,0,0,0">
                        <TextBlock Text="УСТАНАВЛИВАЮ PHANTOM"
                                   Foreground="White" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="InstallStatus" Text="Ищу директорию Counter-Strike 2…"
                                   Foreground="#A0A0A0" FontSize="13" Margin="0,12,0,26"/>
                        <ProgressBar x:Name="InstallProgress" Height="4" Width="395" HorizontalAlignment="Left"
                                     IsIndeterminate="True" Background="#202020" Foreground="White" BorderThickness="0"/>
                        <TextBlock Text="Не закрывай окно до завершения установки."
                                   Foreground="#555555" FontSize="10" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- DONE -->
                <Grid x:Name="DonePanel" Visibility="Collapsed" Opacity="0" ClipToBounds="True">
                    <Image x:Name="DoneArtwork"
                           Source="/assets/installed.png"
                           Width="520" Height="455"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Stretch="UniformToFill" Opacity="0.78"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                        </Image.RenderTransform>
                        <Image.OpacityMask>
                            <RadialGradientBrush Center="0.66,0.50" GradientOrigin="0.66,0.50" RadiusX="0.68" RadiusY="0.80">
                                <GradientStop Color="#FFFFFFFF" Offset="0.32"/>
                                <GradientStop Color="#E8FFFFFF" Offset="0.58"/>
                                <GradientStop Color="#60FFFFFF" Offset="0.81"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Image.OpacityMask>
                    </Image>

                    <Rectangle HorizontalAlignment="Right" Width="570">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FD090909" Offset="0"/>
                                <GradientStop Color="#D4090909" Offset="0.35"/>
                                <GradientStop Color="#47090909" Offset="0.72"/>
                                <GradientStop Color="#08090909" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Width="485" Margin="36,0,0,0">
                        <Border Width="62" Height="62" CornerRadius="31" Background="White" HorizontalAlignment="Left">
                            <TextBlock Text="✓" Foreground="#090909" FontSize="31" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ГОТОВО" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,15,0,0"/>
                        <TextBlock Text="Phantom cfg установлен" Foreground="#A0A0A0" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="InstalledPath" Foreground="#555555" FontSize="10" Margin="0,7,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="445"/>

                        <Border Background="#111111" BorderBrush="#262626" BorderThickness="1"
                                CornerRadius="14" Padding="16" Margin="0,18,0,0" Width="470">
                            <StackPanel>
                                <TextBlock Text="Остался один шаг в Steam" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="ПКМ по Counter-Strike 2 → Свойства → Основные → Параметры запуска"
                                           Foreground="#858585" FontSize="10" Margin="0,6,0,11"/>
                                <Grid>
                                    <Border Background="#080808" CornerRadius="9" Padding="13,10">
                                        <TextBlock Text="+exec Phantom.cfg" Foreground="#EAEAEA" FontFamily="Consolas" FontSize="13"/>
                                    </Border>
                                    <Button x:Name="CopyButton" Content="КОПИРОВАТЬ"
                                            HorizontalAlignment="Right" Width="122" Height="34" Margin="0,0,5,0"
                                            Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10"
                                            Click="CopyButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="ГОТОВО" Style="{StaticResource PrimaryButton}"
                                Width="180" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Finish_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ERROR -->
                <Grid x:Name="ErrorPanel" Visibility="Collapsed" Opacity="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="540">
                        <TextBlock Text="НЕ НАШЁЛ CS2" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" Text="Не удалось найти папку Counter-Strike 2."
                                   Foreground="#999999" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,13,0,22"/>
                        <Button Content="ЗАКРЫТЬ" Style="{StaticResource PrimaryButton}" Width="170" Click="Finish_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="PHANTOM • STANDALONE INSTALLER • NO GAME MODIFICATION"
                       Foreground="#3F3F3F" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>
